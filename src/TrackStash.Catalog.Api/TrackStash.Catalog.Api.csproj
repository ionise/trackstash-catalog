  <ItemGroup>
    <ProjectReference Include="../TrackStash.Catalog.Application/TrackStash.Catalog.Application.csproj" />
    <ProjectReference Include="../../../trackstash-core/src/TrackStash.Core.Sqlite/TrackStash.Core.Sqlite.csproj" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>
</Project>
