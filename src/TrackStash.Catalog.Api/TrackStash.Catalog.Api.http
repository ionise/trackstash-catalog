@baseUrl = http://localhost:5187
# Set apiKey locally in your HTTP client's secret/environment variables, not in this file.
@labelId = replace-with-label-id
@etag = "replace-with-etag-from-response"
@retiredLabelId = replace-with-duplicate-id
@mergeOperationId = replace-with-operation-id-from-preview
@mergeEtag = "replace-with-etag-from-merge-preview"

### Authenticated OpenAPI
GET {{baseUrl}}/openapi/v1.json
Authorization: Bearer {{apiKey}}

### Search labels
GET {{baseUrl}}/api/v1/labels?q=records&page=1&pageSize=25&sort=name&order=asc
Authorization: Bearer {{apiKey}}

### Read label and capture its ETag
GET {{baseUrl}}/api/v1/labels/{{labelId}}
Authorization: Bearer {{apiKey}}

### Create (do not automatically retry POST)
POST {{baseUrl}}/api/v1/labels
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{"name":"Example Records","sortName":"Example"}

### Conditional edit (paste the full quoted ETag above)
PATCH {{baseUrl}}/api/v1/labels/{{labelId}}
Authorization: Bearer {{apiKey}}
Content-Type: application/merge-patch+json
If-Match: {{etag}}

{"sortName":null}

### Replace full editable profile (omission preserves; null text/year and [] clear)
PATCH {{baseUrl}}/api/v1/labels/{{labelId}}
Authorization: Bearer {{apiKey}}
Content-Type: application/merge-patch+json
If-Match: {{etag}}

{
  "profile": {
    "description": "Independent electronic label.",
    "countryCode": "ES",
    "city": null,
    "foundedYear": null,
    "lifecycleStatus": "unknown",
    "notes": null,
    "favourite": false,
    "reviewStatus": "in_progress",
    "links": [
      {
        "kind": "official",
        "url": "https://example.test/",
        "title": "Official website",
        "sourceUrl": null
      }
    ]
  }
}

### Alias inspection
GET {{baseUrl}}/api/v1/labels/{{labelId}}/aliases
Authorization: Bearer {{apiKey}}

### Provider-reference inspection
GET {{baseUrl}}/api/v1/labels/{{labelId}}/external-references
Authorization: Bearer {{apiKey}}

### Missing label: 404 Problem Details
GET {{baseUrl}}/api/v1/labels/nonexistent
Authorization: Bearer {{apiKey}}

### Missing precondition: 428 Problem Details
PATCH {{baseUrl}}/api/v1/labels/{{labelId}}
Authorization: Bearer {{apiKey}}
Content-Type: application/merge-patch+json

{"name":"Edited Example"}

### Preview duplicate retirement into labelId (201 + Location + review ETag; no label changes)
POST {{baseUrl}}/api/v1/labels/{{labelId}}/merge-previews
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{"retiredLabelId":"{{retiredLabelId}}"}

### Read saved review (410 if expired and unapplied)
GET {{baseUrl}}/api/v1/label-merge-previews/{{mergeOperationId}}
Authorization: Bearer {{apiKey}}

### Apply only after reviewing direction, provider IDs, aliases, release links, and blockers
POST {{baseUrl}}/api/v1/label-merge-previews/{{mergeOperationId}}/apply
Authorization: Bearer {{apiKey}}
Content-Type: application/json
If-Match: {{mergeEtag}}

{"reason":"Confirmed both records identify the same label","operator":null}

### Missing merge precondition: 428; changed state returns 412, blockers 409
POST {{baseUrl}}/api/v1/label-merge-previews/{{mergeOperationId}}/apply
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{"reason":"Same label"}

### After apply: retired read redirects 308; retired writes are rejected with canonicalId
GET {{baseUrl}}/api/v1/labels/{{retiredLabelId}}
Authorization: Bearer {{apiKey}}
