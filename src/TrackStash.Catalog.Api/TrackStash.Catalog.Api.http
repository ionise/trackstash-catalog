@baseUrl = http://localhost:5187
@artistId = replace-with-canonical-artist-id
@artistEtag = "replace-with-original-artist-etag"
@artistArtworkEntryId = replace-with-artist-gallery-entry-id
@artistAssetId = replace-with-artist-asset-id

### Manual Artist profile (schema 12); retain this ETag for profile/artwork writes
GET {{baseUrl}}/api/v1/artists/{{artistId}}/profile
Authorization: Bearer {{apiKey}}

### Complete manual profile replacement; missing If-Match 428, stale 412, older schema 409
PATCH {{baseUrl}}/api/v1/artists/{{artistId}}/profile
Authorization: Bearer {{apiKey}}
If-Match: {{artistEtag}}
Content-Type: application/json

{
  "biography": "Manually written Artist biography.",
  "biographySourceUrl": "https://example.test/artist/bio",
  "favourite": true,
  "notes": "Private catalog notes.",
  "reviewStatus": "in_progress",
  "links": [{"kind":"official","url":"https://example.test/artist","title":"Official website","sourceUrl":null}]
}

### Artist portrait/gallery; capture a fresh aggregate ETag before the next write
GET {{baseUrl}}/api/v1/artists/{{artistId}}/artwork
Authorization: Bearer {{apiKey}}

### Upload a portrait with recorded rights; choose a local ./portrait.png
POST {{baseUrl}}/api/v1/artists/{{artistId}}/artwork
Authorization: Bearer {{apiKey}}
If-Match: {{artistEtag}}
Content-Type: multipart/form-data; boundary=artist-portrait-boundary

--artist-portrait-boundary
Content-Disposition: form-data; name="file"; filename="portrait.png"
Content-Type: image/png

< ./portrait.png
--artist-portrait-boundary
Content-Disposition: form-data; name="role"

portrait
--artist-portrait-boundary
Content-Disposition: form-data; name="usageRights"

Permission recorded for this managed copy
--artist-portrait-boundary
Content-Disposition: form-data; name="isPreferred"

true
--artist-portrait-boundary--

### Full Artist gallery replacement; omitted entries detach, assets/history remain
PATCH {{baseUrl}}/api/v1/artists/{{artistId}}/artwork
Authorization: Bearer {{apiKey}}
If-Match: {{artistEtag}}
Content-Type: application/json

{"items":[{"id":"{{artistArtworkEntryId}}","assetId":"{{artistAssetId}}","role":"portrait","caption":null,"isPreferred":true}]}

### Search canonical Artists by literal name/sort-name/alias substring
GET {{baseUrl}}/api/v1/artists?q=Fixture&page=1&pageSize=25
Authorization: Bearer {{apiKey}}

### Artists credited as remixers on releases linked to this Label (not signing affiliations)
GET {{baseUrl}}/api/v1/artists?labelId={{labelId}}&role=remixer&page=1&pageSize=25
Authorization: Bearer {{apiKey}}

### Safe Artist identity details and ETag
GET {{baseUrl}}/api/v1/artists/{{artistId}}
Authorization: Bearer {{apiKey}}

### Grouped release appearances with explicit credit scopes
GET {{baseUrl}}/api/v1/artists/{{artistId}}/releases?page=1&pageSize=25
Authorization: Bearer {{apiKey}}

### Explicit placement/Recording credits, including unplaced Recordings
GET {{baseUrl}}/api/v1/artists/{{artistId}}/tracks?page=1&pageSize=25
Authorization: Bearer {{apiKey}}

### One row per credited placement, combining scopes before paging
# Includes existing release dates and full placement/Recording contributors, alongside this Artist's scoped evidence.
GET {{baseUrl}}/api/v1/artists/{{artistId}}/track-appearances?page=1&pageSize=25
Authorization: Bearer {{apiKey}}

### One row per release with all credit evidence, managed cover ID and linked Labels
GET {{baseUrl}}/api/v1/artists/{{artistId}}/release-appearances?page=1&pageSize=25
Authorization: Bearer {{apiKey}}

### Missing Artist returns 404, not an empty successful detail
GET {{baseUrl}}/api/v1/artists/not-a-catalog-artist
Authorization: Bearer {{apiKey}}

# Set apiKey locally in your HTTP client's secret/environment variables, not in this file.
@labelId = replace-with-label-id
@etag = "replace-with-etag-from-response"
@retiredLabelId = replace-with-duplicate-id
@mergeOperationId = replace-with-operation-id-from-preview
@mergeEtag = "replace-with-etag-from-merge-preview"
@assetId = replace-with-asset-id
@artworkEntryId = replace-with-gallery-entry-id
@backupJobId = replace-with-job-id
@backupId = replace-with-backup-id
@scannerBackupId = replace-with-scanner-backup-id
@relatedLabelId = replace-with-parent-or-distributor-id
@relatedLabelVersion = replace-with-unquoted-related-label-version
@groupId = replace-with-group-id
@groupEtag = "replace-with-group-etag"
@groupVersion = replace-with-unquoted-group-version
@labelVersion = replace-with-unquoted-label-version
@membershipId = replace-with-membership-id
@membershipEtag = "replace-with-membership-etag"
@importOperationId = replace-with-operation-id-from-import-preview
@importEtag = "replace-with-original-import-preview-etag"
@releaseId = replace-with-canonical-release-id
@artworkProvider = replace-with-configured-provider
@artworkCandidateId = replace-with-candidate-id-from-lookup
@artworkCandidateRevision = replace-with-candidate-revision-from-lookup

### Release managed gallery (schema 11); retain this response ETag
GET {{baseUrl}}/api/v1/releases/{{releaseId}}/artwork
Authorization: Bearer {{apiKey}}

### Upload a release cover with recorded rights; replace ./cover.png locally
POST {{baseUrl}}/api/v1/releases/{{releaseId}}/artwork
Authorization: Bearer {{apiKey}}
If-Match: {{etag}}
Content-Type: multipart/form-data; boundary=release-cover-boundary

--release-cover-boundary
Content-Disposition: form-data; name="file"; filename="cover.png"
Content-Type: image/png

< ./cover.png
--release-cover-boundary
Content-Disposition: form-data; name="role"

cover
--release-cover-boundary
Content-Disposition: form-data; name="usageRights"

Permission recorded for this managed copy
--release-cover-boundary
Content-Disposition: form-data; name="isPreferred"

true
--release-cover-boundary--

### Detach all release gallery entries without deleting retained assets/history
PATCH {{baseUrl}}/api/v1/releases/{{releaseId}}/artwork
Authorization: Bearer {{apiKey}}
If-Match: {{etag}}
Content-Type: application/json

{ "items": [] }

### Deliberate candidate lookup (currently no live providers are registered)
GET {{baseUrl}}/api/v1/releases/{{releaseId}}/artwork-candidates
Authorization: Bearer {{apiKey}}

### Explicit managed-copy attachment; no arbitrary source/image URL accepted
POST {{baseUrl}}/api/v1/releases/{{releaseId}}/artwork-candidates/attach
Authorization: Bearer {{apiKey}}
If-Match: {{etag}}
Content-Type: application/json

{
  "provider": "{{artworkProvider}}",
  "candidateId": "{{artworkCandidateId}}",
  "revision": "{{artworkCandidateRevision}}",
  "usageRights": "Permission recorded for this managed copy",
  "confirmed": true
}

### Read-only canonical release list (schema 9+); search title/catalog number
GET {{baseUrl}}/api/v1/releases?q=Block%20House&page=1&pageSize=25
Authorization: Bearer {{apiKey}}

### Release list filtered by its catalog Label, not a provider label ID
GET {{baseUrl}}/api/v1/releases?labelId={{labelId}}&page=1&pageSize=25
Authorization: Bearer {{apiKey}}

### Canonical release detail and separate release-level credits
GET {{baseUrl}}/api/v1/releases/{{releaseId}}
Authorization: Bearer {{apiKey}}

### Paged Recording placements with listing credits and display/source/official numbering
GET {{baseUrl}}/api/v1/releases/{{releaseId}}/tracks?page=1&pageSize=25
Authorization: Bearer {{apiKey}}

### Schema 10 only: create immutable review without canonical writes
POST {{baseUrl}}/api/v1/release-import-previews
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{ "releaseId": 325565 }

### Copy choices and change one identity in a new immutable preview ("evidence" is optional; blank records a standard note)
POST {{baseUrl}}/api/v1/release-import-previews
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "releaseId": 325565,
  "basePreviewId": "{{importOperationId}}",
  "decision": { "kind": "artist", "providerId": 59140, "action": "create", "canonicalId": null, "evidence": "Reviewed the structured F-Project performing identity." }
}

### Read frozen review and paged identities/tracks (never current source pages)
GET {{baseUrl}}/api/v1/release-import-previews/{{importOperationId}}
Authorization: Bearer {{apiKey}}

###
GET {{baseUrl}}/api/v1/release-import-previews/{{importOperationId}}/identities?page=1&pageSize=25
Authorization: Bearer {{apiKey}}

###
GET {{baseUrl}}/api/v1/release-import-previews/{{importOperationId}}/tracks?page=1&pageSize=25
Authorization: Bearer {{apiKey}}

### Atomic apply after all choices are reviewed ("reason" is optional); same token/reason safely recover a saved outcome
POST {{baseUrl}}/api/v1/release-import-previews/{{importOperationId}}/apply
Authorization: Bearer {{apiKey}}
Content-Type: application/json
If-Match: {{importEtag}}

{ "reason": "Reviewed the complete cached release and individual contributor identities.", "confirmed": true }

### Read-only corpus queue (not receipt or media ownership proof)
GET {{baseUrl}}/api/v1/purchase-release-candidates?q=325565&page=1&pageSize=25
Authorization: Bearer {{apiKey}}

### Only candidates not yet admitted (no catalog Release owns the Beatport ID); schema 9+, older schemas 409
GET {{baseUrl}}/api/v1/purchase-release-candidates?hideAdmitted=true&page=1&pageSize=25
Authorization: Bearer {{apiKey}}

### Ready to import and not yet admitted (complete cached source, exactly one matching catalog label)
GET {{baseUrl}}/api/v1/purchase-release-candidates?readyOnly=true&hideAdmitted=true&page=1&pageSize=25
Authorization: Bearer {{apiKey}}

### Inspect Block House; source completeness/digest cover the whole release, tracks are paged
GET {{baseUrl}}/api/v1/purchase-release-candidates/325565?page=1&pageSize=25
Authorization: Bearer {{apiKey}}

### Missing/non-corpus candidate returns 404, invalid IDs return 400
GET {{baseUrl}}/api/v1/purchase-release-candidates/0
Authorization: Bearer {{apiKey}}

### Ready, unadmitted purchase releases for batch admission
GET {{baseUrl}}/api/v1/purchase-release-admissions/ready
Authorization: Bearer {{apiKey}}

### Batch admission dry run (writes nothing; 1-25 IDs)
POST {{baseUrl}}/api/v1/purchase-release-admissions
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{ "releaseIds": [325565], "dryRun": true }

### Batch admission (take a catalog backup first); without confirmed returns 400 confirmation_required
POST {{baseUrl}}/api/v1/purchase-release-admissions
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{ "releaseIds": [325565], "confirmed": true }

### Search flat groups, not release labels
GET {{baseUrl}}/api/v1/label-groups?q=anjuna&kind=family&page=1&pageSize=25&sort=name&order=asc
Authorization: Bearer {{apiKey}}

### Create an umbrella family (organisation is the other kind; no ownership implied)
POST {{baseUrl}}/api/v1/label-groups
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{"kind":"family","name":"Example family","sortName":null,"description":"Reviewed umbrella brand","website":null}

### Read group and capture both its quoted ETag and unquoted version
GET {{baseUrl}}/api/v1/label-groups/{{groupId}}
Authorization: Bearer {{apiKey}}

### Update selected scalar fields; kind is immutable
PATCH {{baseUrl}}/api/v1/label-groups/{{groupId}}
Authorization: Bearer {{apiKey}}
If-Match: {{groupEtag}}
Content-Type: application/merge-patch+json

{"description":"Updated sourced summary","website":null}

### Group-side view of the same memberships; counts include every status
GET {{baseUrl}}/api/v1/label-groups/{{groupId}}/members?status=current&page=1&pageSize=25
Authorization: Bearer {{apiKey}}

### Label-side family and organisation memberships
GET {{baseUrl}}/api/v1/labels/{{labelId}}/group-memberships?status=all&page=1&pageSize=25
Authorization: Bearer {{apiKey}}

### Create one affiliation using fresh endpoint versions; duplicate pair returns 409 + Location
POST {{baseUrl}}/api/v1/label-group-memberships
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{"labelId":"{{labelId}}","groupId":"{{groupId}}","labelVersion":"{{labelVersion}}","groupVersion":"{{groupVersion}}","status":"current","since":"2020","until":null,"source":"Reviewed official site","sourceUrl":"https://example.test","notes":"Affiliation only"}

### Read original membership ETag and current endpoint versions before editing
GET {{baseUrl}}/api/v1/label-group-memberships/{{membershipId}}
Authorization: Bearer {{apiKey}}

### Mark departure, rather than deleting history (complete metadata required)
PATCH {{baseUrl}}/api/v1/label-group-memberships/{{membershipId}}
Authorization: Bearer {{apiKey}}
If-Match: {{membershipEtag}}
Content-Type: application/json

{"labelVersion":"{{labelVersion}}","groupVersion":"{{groupVersion}}","status":"former","since":"2020","until":"2024-03","source":"Reviewed official site","sourceUrl":"https://example.test","notes":"Latest known period"}

### Remove an incorrect assertion only; permanent before/after history remains
DELETE {{baseUrl}}/api/v1/label-group-memberships/{{membershipId}}
Authorization: Bearer {{apiKey}}
If-Match: {{membershipEtag}}

### Derived shared-family labels, deduplicated before pagination with supporting reasons
GET {{baseUrl}}/api/v1/labels/{{labelId}}/related-labels?kind=family&page=1&pageSize=25
Authorization: Bearer {{apiKey}}

### Add a child imprint from the parent's page (one child-to-parent edge)
PATCH {{baseUrl}}/api/v1/labels/{{labelId}}/relationship-edges
Authorization: Bearer {{apiKey}}
If-Match: {{etag}}
Content-Type: application/json

{"id":null,"relatedLabelId":"{{relatedLabelId}}","incoming":true,"type":"imprint_of","source":"Reviewed official site","sourceUrl":"https://example.test","notes":null,"targetVersion":"{{relatedLabelVersion}}","remove":false}

### Missing group: 404
GET {{baseUrl}}/api/v1/label-groups/nonexistent
Authorization: Bearer {{apiKey}}

### Missing membership precondition: 428, no removal
DELETE {{baseUrl}}/api/v1/label-group-memberships/{{membershipId}}
Authorization: Bearer {{apiKey}}

### Authenticated OpenAPI
GET {{baseUrl}}/openapi/v1.json
Authorization: Bearer {{apiKey}}

### Search labels
GET {{baseUrl}}/api/v1/labels?q=records&page=1&pageSize=25&sort=name&order=asc
Authorization: Bearer {{apiKey}}

### Read label and capture its ETag
GET {{baseUrl}}/api/v1/labels/{{labelId}}
Authorization: Bearer {{apiKey}}

### Create (do not automatically retry POST)
POST {{baseUrl}}/api/v1/labels
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{"name":"Example Records","sortName":"Example"}

### Conditional edit (paste the full quoted ETag above)
PATCH {{baseUrl}}/api/v1/labels/{{labelId}}
Authorization: Bearer {{apiKey}}
Content-Type: application/merge-patch+json
If-Match: {{etag}}

{"sortName":null}

### Replace full editable profile (omission preserves; null text/year and [] clear)
PATCH {{baseUrl}}/api/v1/labels/{{labelId}}
Authorization: Bearer {{apiKey}}
Content-Type: application/merge-patch+json
If-Match: {{etag}}

{
  "profile": {
    "description": "Independent electronic label.",
    "countryCode": "ES",
    "city": null,
    "foundedYear": null,
    "lifecycleStatus": "unknown",
    "notes": null,
    "favourite": false,
    "reviewStatus": "in_progress",
    "links": [
      {
        "kind": "official",
        "url": "https://example.test/",
        "title": "Official website",
        "sourceUrl": null
      }
    ]
  }
}

### Read incoming/outgoing relationships and capture current owner ETag
GET {{baseUrl}}/api/v1/labels/{{labelId}}/relationships
Authorization: Bearer {{apiKey}}

### Replace outgoing relationships only (also capture the related label version from GET/search)
# Null ID creates; use an existing returned edge ID to preserve its identity/date.
# Incoming edges are never replaced. [] clears outgoing edges.
# Missing If-Match: 428; changed owner/target: 412 relationship_state_changed.
# Self-links, duplicates, imprint cycles or invalid evidence: 400; retired write: 409.
PATCH {{baseUrl}}/api/v1/labels/{{labelId}}/relationships
Authorization: Bearer {{apiKey}}
Content-Type: application/json
If-Match: {{etag}}

{
  "items": [
    {
      "id": null,
      "toLabelId": "{{relatedLabelId}}",
      "type": "imprint_of",
      "source": "manual",
      "sourceUrl": "https://example.test/label-history",
      "notes": "Reviewed parent relationship; these are distinct identities.",
      "targetVersion": "{{relatedLabelVersion}}"
    }
  ]
}

### Alias inspection
GET {{baseUrl}}/api/v1/labels/{{labelId}}/aliases
Authorization: Bearer {{apiKey}}

### Read ordered artwork (capture current label ETag before any artwork write)
GET {{baseUrl}}/api/v1/labels/{{labelId}}/artwork
Authorization: Bearer {{apiKey}}

### Upload a local logo (choose a local file; POST is not automatically retried)
POST {{baseUrl}}/api/v1/labels/{{labelId}}/artwork
Authorization: Bearer {{apiKey}}
If-Match: {{etag}}
Content-Type: multipart/form-data; boundary=trackstash-artwork-boundary

--trackstash-artwork-boundary
Content-Disposition: form-data; name="file"; filename="logo.png"
Content-Type: image/png

< ./logo.png
--trackstash-artwork-boundary
Content-Disposition: form-data; name="role"

logo
--trackstash-artwork-boundary
Content-Disposition: form-data; name="usageRights"

Private reference; permission not verified
--trackstash-artwork-boundary
Content-Disposition: form-data; name="isPreferred"

true
--trackstash-artwork-boundary--

### Full gallery edit: array order sets order, omitted entries detach; [] clears all
PATCH {{baseUrl}}/api/v1/labels/{{labelId}}/artwork
Authorization: Bearer {{apiKey}}
Content-Type: application/json
If-Match: {{etag}}

{"items":[{"id":"{{artworkEntryId}}","assetId":"{{assetId}}","role":"logo","caption":null,"isPreferred":true}]}

### Protected original (no API keys in the URL)
GET {{baseUrl}}/api/v1/artwork-assets/{{assetId}}/original
Authorization: Bearer {{apiKey}}

### Protected thumbnail (no public image exemption)
GET {{baseUrl}}/api/v1/artwork-assets/{{assetId}}/thumbnail
Authorization: Bearer {{apiKey}}

### Provider-reference inspection
GET {{baseUrl}}/api/v1/labels/{{labelId}}/external-references
Authorization: Bearer {{apiKey}}

### Missing label: 404 Problem Details
GET {{baseUrl}}/api/v1/labels/nonexistent
Authorization: Bearer {{apiKey}}

### Missing precondition: 428 Problem Details
PATCH {{baseUrl}}/api/v1/labels/{{labelId}}
Authorization: Bearer {{apiKey}}
Content-Type: application/merge-patch+json

{"name":"Edited Example"}

### Preview duplicate retirement into labelId (201 + Location + review ETag; no label changes)
POST {{baseUrl}}/api/v1/labels/{{labelId}}/merge-previews
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{"retiredLabelId":"{{retiredLabelId}}"}

### Read saved review (410 if expired and unapplied)
GET {{baseUrl}}/api/v1/label-merge-previews/{{mergeOperationId}}
Authorization: Bearer {{apiKey}}

### Apply only after reviewing direction, provider IDs, aliases, release links, and blockers
POST {{baseUrl}}/api/v1/label-merge-previews/{{mergeOperationId}}/apply
Authorization: Bearer {{apiKey}}
Content-Type: application/json
If-Match: {{mergeEtag}}

{"reason":"Confirmed both records identify the same label","operator":null}

### Missing merge precondition: 428; changed state returns 412, blockers 409
POST {{baseUrl}}/api/v1/label-merge-previews/{{mergeOperationId}}/apply
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{"reason":"Same label"}

### After apply: retired read redirects 308; retired writes are rejected with canonicalId
GET {{baseUrl}}/api/v1/labels/{{retiredLabelId}}
Authorization: Bearer {{apiKey}}
### List saved catalog/artwork ZIPs
GET {{baseUrl}}/api/v1/backups
Authorization: Bearer {{apiKey}}

### Start backup (202 with job Location; no request body)
POST {{baseUrl}}/api/v1/backup-jobs
Authorization: Bearer {{apiKey}}

### Inspect job (replace ID from accepted response)
GET {{baseUrl}}/api/v1/backup-jobs/{{backupJobId}}
Authorization: Bearer {{apiKey}}

### Export existing verified archive (replace ID from list or completed job)
GET {{baseUrl}}/api/v1/backups/{{backupId}}/download
Authorization: Bearer {{apiKey}}

### Missing backup returns Problem Details
GET {{baseUrl}}/api/v1/backups/not-found/download
Authorization: Bearer {{apiKey}}

### Discover configured backup scopes (no source paths)
GET {{baseUrl}}/api/v1/backup-sources
Authorization: Bearer {{apiKey}}

### List scanner inventory backups (409 until scanner database path is configured)
GET {{baseUrl}}/api/v1/backups?kind=scanner
Authorization: Bearer {{apiKey}}

### Start scanner inventory backup (empty body)
POST {{baseUrl}}/api/v1/backup-jobs?kind=scanner
Authorization: Bearer {{apiKey}}

### Download saved scanner ZIP (job status uses the same backup-jobs/{id} endpoint above)
GET {{baseUrl}}/api/v1/backups/{{scannerBackupId}}/download?kind=scanner
Authorization: Bearer {{apiKey}}

### Tracks: newest first, one row per Recording (the top-level Tracks list)
GET {{baseUrl}}/api/v1/tracks?groupBy=recording&page=1&pageSize=25
Authorization: Bearer {{apiKey}}

### Tracks on a release in release order
GET {{baseUrl}}/api/v1/tracks?releaseId={{releaseId}}
Authorization: Bearer {{apiKey}}

### Tracks remixed by an Artist, searched (every word must match) and sorted by title
GET {{baseUrl}}/api/v1/tracks?artistId={{artistId}}&role=remixer&q=original%20mix&sort=title&order=asc
Authorization: Bearer {{apiKey}}

### Invalid sort returns 400 validation_failed
GET {{baseUrl}}/api/v1/tracks?sort=bpm
Authorization: Bearer {{apiKey}}

### Recording detail; a missing ID returns 404 recording_not_found
GET {{baseUrl}}/api/v1/recordings/replace-with-canonical-recording-id
Authorization: Bearer {{apiKey}}
